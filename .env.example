# Database Configuration (PostgreSQL)
# "localhost" porque Next.js corre en tu máquina y Docker publica el puerto 5432.
# Solo usarías "db" si la propia app corriera dentro de docker compose.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/casecraft_db?schema=public"

# Authentication Secrets (Requirement A4 & A10)
AUTH_SECRET="replace_with_random_32_char_secret_key"
NEXTAUTH_URL="http://localhost:3000"

# Stripe Sandbox Keys - Test Mode Only (Requirement A6)
STRIPE_PUBLIC_KEY="pk_test_replace_with_your_stripe_test_key"
STRIPE_SECRET_KEY="sk_test_replace_with_your_stripe_test_key"
STRIPE_WEBHOOK_SECRET="whsec_replace_with_stripe_cli_webhook_secret"
