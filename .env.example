# Database Configuration (PostgreSQL)
# "localhost" because Next.js runs locally while Docker exposes port 5432.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/casecraft_db?schema=public"

# Authentication Secrets (Requirements A4 & A10)
AUTH_SECRET="replace_with_random_32_char_secret_key"
NEXTAUTH_URL="http://localhost:3000"

# Stripe Sandbox Keys - Test Mode Only (Requirement A6)
STRIPE_PUBLIC_KEY="pk_test_replace_with_your_stripe_test_key"
STRIPE_SECRET_KEY="sk_test_replace_with_your_stripe_test_key"
STRIPE_WEBHOOK_SECRET="whsec_replace_with_stripe_cli_webhook_secret"

# Default Admin Account created by prisma/seed.ts (Requirement A9)
SEED_ADMIN_EMAIL="admin@casecraft.test"
SEED_ADMIN_PASSWORD="Admin1234!"

# Mailtrap SMTP Sandbox (Bonus B6)
MAILTRAP_HOST="sandbox.smtp.mailtrap.io"
MAILTRAP_PORT="2525"
MAILTRAP_USER="replace_with_mailtrap_inbox_username"
MAILTRAP_PASS="replace_with_mailtrap_inbox_password"
MAILTRAP_FROM="CaseCraft Store <orders@casecraft.test>"